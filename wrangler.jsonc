// Cloudflare Workers config (deployed via @opennextjs/cloudflare).
// Secrets (SUPABASE keys) are set with `npx wrangler secret put`, never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "restaurant-erp",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
