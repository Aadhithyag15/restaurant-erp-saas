# Supabase — Settings → API in your project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never prefix with NEXT_PUBLIC_, never expose to the browser.
# Not read by any code path yet (reserved for future privileged route
# handlers). In production, set with `wrangler secret put` — never here.
SUPABASE_SERVICE_ROLE_KEY=

# Local dev: http://localhost:3000
# Production: the deployed URL, e.g. https://restaurant-erp.<account>.workers.dev
# or your custom domain. Required at BUILD time — NEXT_PUBLIC_* values are
# inlined into the client bundle (see scripts/check-env.mjs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protects app-side maintenance endpoints (generate: openssl rand -hex 16).
# Not read by any code path yet. In production, set with `wrangler secret put`.
CRON_SECRET=

# --- Production-only: not read by the app, used by scripts/configure-supabase-auth.mjs ---
# to switch Supabase Auth email (confirmations, password resets, invites)
# from the shared/no-SMTP sender to Resend. See docs/DEPLOYMENT.md.
# SUPABASE_ACCESS_TOKEN=        # supabase.com/dashboard/account/tokens
# SUPABASE_PROJECT_REF=         # the <ref> in NEXT_PUBLIC_SUPABASE_URL
# SITE_URL=                     # production app URL
# RESEND_API_KEY=                # resend.com -> API Keys
# RESEND_SENDER_EMAIL=           # verified sender, e.g. noreply@example.com

# Phase 5 — payments (leave empty for now)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
